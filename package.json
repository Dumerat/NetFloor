{
  "name": "netfloor-architect",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.5",
  "scripts": {
    "dev": "next dev",
    "build": "tsc --noEmit",
    "build:next": "next build",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/db/seed.ts",
    "test:trace": "tsx src/db/test-trace.ts",
    "test:pglite": "tsx src/db/test-trace-pglite.ts",
    "test:spatial": "tsx src/engine/spatial/tests/spatial.test.ts",
    "test:ingestion": "tsx src/engine/ingestion/tests/ingestion.test.ts",
    "prepare": "husky",
    "commitlint": "commitlint --edit"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.2",
    "konva": "^10.4.0",
    "ldapts": "^9.0.0",
    "lucide-react": "^1.42.0",
    "net-snmp": "^3.26.3",
    "next": "^16.3.4",
    "postgres": "^3.4.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-konva": "^19.2.6",
    "tailwind-merge": "^3.6.0",
    "zod": "^3.24.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^9.21.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/net-snmp": "^3.23.0",
    "@types/node": "^22.13.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitest/coverage-v8": "^3.0.7",
    "autoprefixer": "^10.5.5",
    "drizzle-kit": "^0.30.4",
    "eslint": "^9.21.0",
    "fake-indexeddb": "^6.2.5",
    "husky": "^9.1.7",
    "postcss": "^8.5.28",
    "prettier": "^3.5.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.25.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.0.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
